# скопировать в .env и заполнить

# 1 - разработка, 0 - рабочий режим
DJANGO_DEBUG=1
# нужен при DJANGO_DEBUG=0: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# если сайт работает по https
# DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.ru
# DJANGO_HTTPS=1


DB_ENGINE=postgres
POSTGRES_DB=pcshop
POSTGRES_USER=pcshop
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# или одной строкой:
# DATABASE_URL=postgresql://pcshop:пароль@localhost:5432/pcshop
# без PostgreSQL:
# DB_ENGINE=sqlite


REDIS_URL=redis://127.0.0.1:6379/0
# без Redis: REDIS_URL=memory://
